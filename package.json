    "dev-tools",
    "game-development"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alexfdr/three-scene-inspector.git"
  },
  "bugs": {
    "url": "https://github.com/alexfdr/three-scene-inspector/issues"
  },
  "homepage": "https://github.com/alexfdr/three-scene-inspector#readme",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "three": "^0.169.0",
    "tweakpane": "^4.0.0",
    "tweakpane-plugin-media": "^1.0.7"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^20.19.30",
    "@types/three": "^0.169.0",
    "three": "^0.169.0",
    "tweakpane": "^4.0.4",
    "tweakpane-plugin-media": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  }
