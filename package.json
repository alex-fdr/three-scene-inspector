      "types": "./dist/three-scene-inspector.d.ts",
      "import": "./dist/three-scene-inspector.es.js",
      "require": "./dist/three-scene-inspector.umd.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "three",
    "threejs",
    "three.js",
    "inspector",
    "debugger",
